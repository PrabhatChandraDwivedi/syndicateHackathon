# ReconcileOS — environment
# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------- inference
# TensorMux is the primary provider (hackathon partner, 50M tokens per key).
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_API_KEY=                      # tmx_...
TENSORMUX_MODEL=glm-4-7-flash

# OpenAI is the SECONDARY provider in the router's fallback chain.
# This is what makes the chaos harness's "LLM 500" injection survivable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- observability
# Neatlogs: sign up at neatlogs.com, copy the project API key.
# init() runs at the top of app/main.py, BEFORE any LLM client import.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=reconcileos

# ---------------------------------------------------------------- payments
# Dodo Payments TEST MODE ONLY. Ask in #syndicate-help for same-day verification.
# The server refuses to boot if DODO_MODE is anything other than "test".
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=test

# ---------------------------------------------------------------- app
DB_PATH=./reconcileos.db
POLICY_VERSION=v1
DEFAULT_ACTOR_ID=finance_user_01
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=5173

# ---------------------------------------------------------------- notifications
# Console + file are the demo defaults. Slack/SMTP are optional sinks.
NOTIFY_SINKS=console,file
SLACK_WEBHOOK_URL=
