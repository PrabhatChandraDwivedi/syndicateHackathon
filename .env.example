# ReconcileOS — environment
# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------- inference
# OpenAI is the PRIMARY provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini                # bulk / closed-label tasks
OPENAI_MODEL_REASONING=gpt-4.1          # cash-application shortlist, drafting

# TensorMux is the FALLBACK leg (hackathon partner, 50M free tokens per key).
# This is what makes the chaos harness's "LLM 500" injection survivable.
# NOTE: glm-4-7-flash returns its answer in `reasoning` when max_tokens is tight
# and `content` comes back null. Budget generously; never treat null as failure.
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_API_KEY=                      # tmx_...
TENSORMUX_MODEL=glm-4-7-flash

# ---------------------------------------------------------------- observability
# Neatlogs: sign up at neatlogs.com, copy the project API key.
# init() runs at the top of app/main.py, BEFORE any LLM client import.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=reconcileos

# ---------------------------------------------------------------- app
DB_PATH=./reconcileos.db
POLICY_VERSION=v1
DEFAULT_ACTOR_ID=finance_user_01
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=5173

# ---------------------------------------------------------------- notifications
# Console + file are the demo defaults. Slack/SMTP are optional sinks.
NOTIFY_SINKS=console,file
SLACK_WEBHOOK_URL=
